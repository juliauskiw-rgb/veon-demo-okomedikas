---
import Section from "../Section.astro";
import Tel from "../Tel.astro";
import { CLINIC, CLINIC_2 } from "../../data/contacts";
---
<Section id="hero" rec="UX-R002,UX-R019" class="hero on-wall">
  <div class="hero__grid container">
    <div class="hero__text">
      <h1 data-rec="SEO-R003">Офтальмологічна клініка в Черкасах</h1>
      <p class="hero__dirs">Катаракта, глаукома, сітківка, діти, оптика</p>
      <div class="hero__actions">
        <a class="btn hero__call" href={CLINIC.href} data-plate><span>Подзвонити:</span> <span class="nb">{CLINIC.label}</span></a>
        <a class="hero__alt" href="#routes">З чим ви звертаєтесь?</a>
      </div>
      <p class="hero__where"><span class="nb">проспект Перемоги, 16.</span> <span class="nb">Пн–Пт, до 17:00.</span> <span class="hero__tel2">Другий номер: <Tel phone={CLINIC_2} /></span></p>
    </div>
    <figure class="hero__photo">
      <img
        src="img/building-718.webp"
        srcset="img/building-480.webp 480w, img/building-718.webp 718w"
        sizes="(min-width: 64rem) 46vw, 100vw"
        width="718" height="478" loading="eager" fetchpriority="high" decoding="async"
        alt="Будівля клініки «Окомедікас» у Черкасах"
      />
    </figure>
  </div>
</Section>
